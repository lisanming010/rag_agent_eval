# agent配置
agents:
  # 使用何种形式接入agent
  type: http
  http_agent:
    # 最高调用并发
    call_agent_th_max: 8
    # 提交间隔（秒），控制提交频率避免服务端响应超时
    submit_delay: 2
    # Agent调用失败重试次数（不含首次调用）
    call_agent_max_retries: 3
    # 重试间隔（秒）
    call_agent_retry_delay: 2
    # 每个类的独立配置
    class_config:
      PVAssistant:
        enabled: true
        # true 时仅调用 Agent 并写入 tmp，不执行评测与报告生成
        is_agent_only: false
        endpoint: https://xxxx
        business_token: test
      Diagnosis:
        enabled: false
        is_agent_only: false
        endpoint: ""
        business_token: ""
      DataQA:
        enabled: false
        is_agent_only: false
        endpoint: ""
        business_token: ""
      RAGFlowRetriever:
        enabled: false
        is_agent_only: false
    # RAGFlow 知识库检索配置
    ragflow:
      api_url: http://192.168.100.225
      dataset_id: ""
      top_k: 1024
      similarity_threshold: 0.5
      vector_similarity_weight: 0.7

# 评价模型配置
judge_llm:
  anthropic:
    model: claude-opus-4-7
    temperature: 0
    max_token: 4096

# 不同的metrics配置
metric_conf:
  contextual_recall: 
    threshold: 0.7
  reverse_validation:
    threshold: 0.7
  mrr:
    threshold: 0.7
    topk: 0
  recall_k:
    threshold: 0.8
    topk: 5
  precision_k:
    threshold: 0.6
    topk: 5
  # 需要通过多模型复核的指标（仅 LLM 类指标需要复核，纯代码断言无需）
  needs_review:
    - reverse_validation
    - contextual_recall

# 评价器配置
evluate:
  # False 时有效并发为 1，仍直接使用指标异步接口
  run_async: True
  # 主评、复核、结构化与重试共用的指标执行并发上限
  max_concurrent: 10
  # 所有指标尝试共用的启动间隔（秒）
  throttle_value: 1
  # 单次指标 a_measure 超时（秒），不包含排队与重试退避
  metric_timeout: 180

dataset:
  # 测试用例集存放路径，可以指定文件夹也可以指定具体某个测试用例集csv文件
  # 当指定的是具体的csv文件时需要手动指定需要调用的metrics名称
  # 当指定的是文件夹时将会自动寻找寻找test_cases_xxx.csv文件，匹配规则：test_cases开头的csv文件
  default_dataset_path: test/
  
  # 如果指定了测试用例集路径则需要在此指定用例集的metric
  metrics_if_specify_csv:
    - reverse_validation
    - contextual_recall

  # 如果指定的是用例集路径，则需要在此处指定默认用例集与希望调用的metrics映射关系
  dataset_metrics_map:
    base:
      - reverse_validation
      - contextual_recall
    hallucination:
      - reverse_validation
      - contextual_recall
    inference:
      - reverse_validation
      - contextual_recall
    retrieval:
      - reverse_validation
      - contextual_recall
    robustness:
      - reverse_validation
      - contextual_recall
    multiturn:
      - reverse_validation
      - contextual_recall
    sungrow_general_zh:
      - contextual_recall
    sungrow_general_en:
      - contextual_recall

  # 占位符填充：执行前将测试数据中的 [xxx] 替换为实体映射中的随机实体
  placeholder_fill:
    # 是否需要执行占位符替换
    enabled: true
    # 是否需要刷新实体映射表：执行替换前先调用业务平台接口更新 entity_mapping.json
    # （登录/接口失败时中断执行；也可用 CLI 参数 --refresh-entities 临时开启）
    refresh_entities: false
    # 实体映射文件路径（相对项目根目录）
    entity_mapping_path: test_suite/dataqa/entity_mapping.json
    # 触发填充的数据集路径片段：用例源 CSV 路径包含任一片段即启用填充
    target_dirs:
      - dataqa
    # 填充后数据集输出目录（保留原文件名，已存在同名文件时覆盖）；
    # 该目录会被嗅探扫描排除，保证未填充/已填充数据集严格隔离
    output_dir: test_suite/dataqa/filled/

# 业务平台登录配置
business_platform:
  login_url: "https://pmms01-test.rundoai.com/api/system/login"
  username: "your_username"
  password: "your_password"
  # 业务平台 API 基础地址（业务接口调用客户端使用，置顶接口实施时启用）
  # api_base_url: "https://pmms01-test.rundoai.com"
  # 设备信息采集（接口 /api/device/basic-list-page）：每类设备采集条数（可配置）
  device_page_size: 10

result:
  save_path: result/
  write_batch_size: 20  # 持续评价中累计终态结果的落盘批量，10–30；多轮父用例计 1 条
